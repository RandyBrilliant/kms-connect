# frozen_string_literal: true

# Uploads a pre-built IPA to TestFlight for **internal** testers only.
# Never submits for App Store review.

default_platform(:ios)

platform :ios do
  desc "Upload an existing release IPA to TestFlight (internal testers)"
  lane :testflight_internal do
    ipa_path = ENV.fetch("IPA_PATH") do
      candidates = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)]
      UI.user_error!("No IPA found under build/ios/ipa/") if candidates.empty?
      candidates.first
    end

    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end