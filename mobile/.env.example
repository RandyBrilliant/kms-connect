# API base URL for Flutter (must match backend host + port).
#
# iOS Simulator:  http://localhost:8000
# Physical iPhone (same Wi‑Fi as Mac): use Mac LAN IP — ipconfig getifaddr en0
# Android emulator: http://10.0.2.2:8000
#
# Backend must listen on all interfaces:
#   python manage.py runserver 0.0.0.0:8000
API_BASE_URL=http://192.168.0.244:8000

# Optional: Web OAuth client ID (same as backend GOOGLE_CLIENT_ID). Use when
# google-services.json has empty oauth_client or Firebase cannot auto-link OAuth.
# GOOGLE_WEB_CLIENT_ID=268800410479-xxxx.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Firebase native config (Android / iOS — required for push & Google Sign-In)
# -----------------------------------------------------------------------------
# After clone, download from Firebase Console (project kms-connect-1541d) or copy
# from a teammate, then place at:
#   android/app/google-services.json
#   ios/Runner/GoogleService-Info.plist
# Templates (no secrets): google-services.json.example, GoogleService-Info.plist.example
# iOS bundle ID and Android applicationId must both be: id.kmsconnect.app
#
# -----------------------------------------------------------------------------
# Firebase (Flutter web / desktop only)
# -----------------------------------------------------------------------------
# Android and iOS use android/app/google-services.json and
# ios/Runner/GoogleService-Info.plist — no FIREBASE_* keys needed in .env.
#
# FIREBASE_API_KEY=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_PROJECT_ID=kms-connect-1541d
# FIREBASE_STORAGE_BUCKET=kms-connect-1541d.firebasestorage.app
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_IOS_BUNDLE_ID=id.kmsconnect.app
# FIREBASE_MEASUREMENT_ID=
